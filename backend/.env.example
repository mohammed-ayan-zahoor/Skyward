# ==============================================================================
# Skyward Backend Environment Configuration Template (MongoDB)
# ==============================================================================

PORT=7001
NODE_ENV=production

# MongoDB Database Connection URL (replace host, port, db_name or use MongoDB Atlas URI)
DATABASE_URL="mongodb://127.0.0.1:27017/skyward_db"

# JWT Secret Key for Admin Authentication Cookie (generate a strong random string)
JWT_SECRET="skyward_prod_jwt_secret_key_replace_this_with_random_string_12345"

# Frontend URL allowed for CORS credentials
FRONTEND_URL="https://skyward.yourdomain.com"
