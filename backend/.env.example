# ==============================================================================
# Skyward Backend Environment Configuration Template
# ==============================================================================

PORT=7001
NODE_ENV=production

# PostgreSQL Database Connection URL (replace username, password, host, port, db_name)
DATABASE_URL="postgresql://skyward_user:YOUR_STRONG_PASSWORD@localhost:5432/skyward_db?schema=public"

# JWT Secret Key for Admin Authentication Cookie (generate a strong random string)
JWT_SECRET="skyward_prod_jwt_secret_key_replace_this_with_random_string_12345"

# Frontend URL allowed for CORS credentials
FRONTEND_URL="https://skyward.yourdomain.com"
