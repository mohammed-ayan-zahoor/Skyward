# Database Connection URL (PostgreSQL)
# Replace placeholder values with your database credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skyward?schema=public"

# JWT Secret Key for Session Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key"

# Frontend Application URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Server Port
PORT=5000
